<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <PackageReadmeSource>$(MSBuildThisFileDirectory)README.md</PackageReadmeSource>
    <Description>MongoDB setup for Livestock Information Service (LIS) .NET services: a client factory for the configured database, camel-case BSON conventions, and AWS IAM authentication support.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="MongoDB.Driver.Authentication.AWS" />
  </ItemGroup>
</Project>
